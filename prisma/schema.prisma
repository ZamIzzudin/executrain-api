generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  username     String
  display_name String?
  password     String
  role_id      String   @db.VarChar(24)
  role         Role     @relation(fields: [role_id], references: [id])
  created_at   DateTime @default(now())

  @@index([username])
  @@index([role_id])
}

/// RBAC: Role (peran pengguna CMS)
model Role {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  name        String   @unique
  description String?
  is_system   Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  users       User[]
  permissions RoleMenu[]
}

/// RBAC: Menu (item navigasi CMS, tersedia utk di-assign ke role)
model Menu {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  code        String   @unique
  label       String
  path        String?
  icon        String?
  parent_code String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  permissions RoleMenu[]

  @@index([parent_code])
  @@index([sort_order])
}

/// RBAC: relasi Role-Menu (menu yang boleh diakses role)
model RoleMenu {
  role_id String @db.VarChar(24)
  menu_id String @db.VarChar(24)

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@id([role_id, menu_id])
  @@index([menu_id])
}

model SkillAccelerator {
  id          String                    @id @default(nanoid()) @db.VarChar(24)
  title       String
  banner      Json                      @default("{\"url\": \"\", \"public_id\": \"\"}")
  category    String
  description String
  student     Int                       @default(0)
  duration    Int                       @default(0)
  skill_level SkillAcceleratorLevel     @default(BEGINNER)
  language    SkillAcceleratorLanguage  @default(INDONESIA)
  feature     String[]
  updated_at  DateTime                  @default(now())
  created_at  DateTime                  @default(now())

  @@index([category])
  @@index([created_at])
}

model Course {
  id             String        @id @default(nanoid()) @db.VarChar(24)
  title          String
  banner         Json          @default("{\"url\": \"\", \"public_id\": \"\"}")
  category       String
  description    String
  student        Int           @default(0)
  duration       Int           @default(0)
  skill_level    CourseLevel   @default(BEGINNER)
  language       CourseLanguage @default(INDONESIA)
  framework_type String        @default("Training")
  feature        String[]
  updated_at     DateTime      @default(now())
  created_at     DateTime      @default(now())

  @@index([category])
  @@index([created_at])
}

model LearningPath {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  description String   @default("")
  banner      Json     @default("{\"url\": \"\", \"public_id\": \"\"}")
  framework   String // scope id framework (ai/data/auto/cyber/governance/service/pm/ea/core)
  category    String // value FRAMEWORK_ITEM di dalam framework tsb
  is_active   Boolean  @default(true)
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  stages LearningPathStage[]

  @@index([framework])
  @@index([category])
  @@index([created_at])
}

model LearningPathStage {
  id              String   @id @default(nanoid()) @db.VarChar(24)
  learning_path_id String  @db.VarChar(24)
  name            String // scope bebas: Beginner / Expert / dll
  description     String   @default("")
  course_ids      String[] // id course yang masuk stage ini
  course_links    Json      @default("[]") // [{ course_id, follows_course_id }]: course di stage ini yang merupakan lanjutan dari course di stage sebelumnya
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  learning_path LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  @@index([learning_path_id])
}

model MasterData {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  type       String
  label      String
  value      String
  scope      String? // grup tambahan (mis. FRAMEWORK_ITEM memakai scope = ai/data/auto/...)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([type, value])
  @@index([type, scope, sort_order])
}

model ITProduct {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  description String
  banner      Json     @default("{\"url\": \"\", \"public_id\": \"\"}")
  tech_stack  String[]
  link        String?
  problem     String?
  feature     String[]
  compliance  String?
  highlight   Json     @default("[]")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([created_at])
}

model AppDevelopment {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  tech_stack  String[]
  description String
  banner      Json     @default("{\"url\": \"\", \"public_id\": \"\"}")
  challenge   String?
  team_size   Json     @default("[]")
  timeline    Int      @default(0)
  methodology String?
  compliance  String?
  highlights  Json     @default("[]")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([created_at])
}

model CaseStudy {
  id              String   @id @default(nanoid()) @db.VarChar(24)
  title           String
  category        String?
  description     String
  industries      String[]
  solutions       String[]
  deployment_type String?
  timeline        Int      @default(0)
  compliance      String?
  methodology     String?
  team_size       Json     @default("[]")
  testimonial     Json     @default("{\"testimoni\": \"\", \"name\": \"\", \"company\": \"\"}")
  link            String?
  updated_at      DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([created_at])
}

model Article {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  title      String
  category   String[]
  content    String   @db.Text
  updated_at DateTime @default(now())
  created_at DateTime @default(now())

  @@index([created_at])
}

/// Content Management: Asset
model Asset {
  id                 String        @id @default(nanoid()) @db.VarChar(24)
  category           AssetCategory @unique
  name               String
  url                String
  public_id          String        @default("")
  fallback_url       String        @default("")
  fallback_public_id String        @default("")
  type               AssetType     @default(image)
  is_active          Boolean       @default(true)
  updated_at         DateTime      @default(now())
  created_at         DateTime      @default(now())
}

/// Content Management: Partner
model Partner {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  partner_name String?
  logo         Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at   DateTime @default(now())
  created_at   DateTime @default(now())
}

/// Content Management: Career
model Career {
  id                     String          @id @default(nanoid()) @db.VarChar(24)
  title                  String
  slug                   String          @unique
  description            String[]
  requirements           String[]
  experiance_requirement String[]
  applicant_question     String[]
  location               String
  department             String          @default("")
  job_type               JobType         @default(FULL_TIME)
  experience_level       ExperienceLevel @default(MID)
  vacancies              Int             @default(1)
  contact_email          String          @default("")
  deadline               DateTime?
  status                 JobStatus       @default(DRAFT)
  applicants_count       Int             @default(0)
  views                  Int             @default(0)
  updated_at             DateTime        @default(now())
  created_at             DateTime        @default(now())

  applicants CareerApplicant[]

  @@index([status])
  @@index([department])
  @@index([location])
}

/// Content Management: CareerApplicant
model CareerApplicant {
  id                String            @id @default(nanoid()) @db.VarChar(24)
  career_id         String            @db.VarChar(24)
  full_name         String
  email             String
  phone             String
  cover_letter      String?
  resume            Json              @default("{}")
  portfolio_url     String?
  linkedin_url      String?
  github_url        String?
  experience_years  Int               @default(0)
  current_position  String?
  current_company   String?
  availability_date DateTime?
  status            ApplicationStatus @default(PENDING)
  notes             String?
  applied_at        DateTime          @default(now())
  updated_at        DateTime          @default(now())

  career Career @relation(fields: [career_id], references: [id], onDelete: Cascade)

  @@index([career_id])
  @@index([email])
  @@index([status])
}

/// Content Management: CareerGallery
model CareerGallery {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  description String   @default("")
  image       Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([order])
  @@index([is_active])
}

/// Content Management: Gallery
model Gallery {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  title      String   @default("")
  image      Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  order      Int      @default(0)
  is_active  Boolean  @default(true)
  updated_at DateTime @default(now())
  created_at DateTime @default(now())

  @@index([order])
  @@index([is_active])
}

/// Content Management: Socmed
model Socmed {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  socmed_name String?
  socmed_link String?
  logo        Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())
}

/// Content Management: Statistic
model Statistic {
  id                       String   @id @default(nanoid()) @db.VarChar(24)
  year_experience          Int?
  total_participant        Int?
  total_topic_class        Int?
  total_training_completed Int?
  updated_at               DateTime @default(now())
  created_at               DateTime @default(now())
}

/// Content Management: Testimonial
model Testimonial {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  person_name  String?
  person_title String?
  testimonial  String?
  photo        Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at   DateTime @default(now())
  created_at   DateTime @default(now())
}

/// Schedule: jadwal kelas tersedia untuk Course Catalog & Skill Accelerator.
/// Satu baris = satu sesi kelas pada satu tanggal (polymorphic ke Course / SkillAccelerator).
/// `entity_id` menyimpan id tabel sumber tanpa FK (karena dua entitas berbeda).
model Schedule {
  id            String                @id @default(nanoid()) @db.VarChar(24)
  entity_type   ScheduleEntityType
  entity_id     String                @db.VarChar(24)
  program_name  String                @default("")
  schedule_date DateTime
  is_active     Boolean               @default(true)
  updated_at    DateTime              @default(now())
  created_at    DateTime              @default(now())

  @@index([entity_type])
  @@index([entity_id])
  @@index([schedule_date])
  @@index([is_active])
  @@unique([entity_type, entity_id, schedule_date])
}

enum ScheduleEntityType {
  COURSE
  SKILL_ACCELERATOR
}

/// Pages: konten halaman statis (About, dsb.) untuk compro.
/// Satu baris per halaman, diidentifikasi via `code` (mis. "about").
/// `content` menyimpan JSON utuh sesuai struktur halaman (copywriting,
/// array awards/join steps, CTA, dll).
model PageContent {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  code       String   @unique
  title      String   @default("")
  content    Json     @default("{}")
  is_active  Boolean  @default(true)
  updated_at DateTime @default(now())
  created_at DateTime @default(now())

  @@index([is_active])
}

enum AssetCategory {
  hero_background
  hero_video
  about_image
  statistic_background
  steps_background
  services_image
  cta_schedule_image
  contact_image
  framework_banner
  hero_blog
  hero_career
  hero_contact
  hero_free_trial
  hero_product
  hero_schedule
  hero_service
}

enum AssetType {
  image
  video
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

enum SkillAcceleratorLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillAcceleratorLanguage {
  INDONESIA
  ENGLISH
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseLanguage {
  INDONESIA
  ENGLISH
}