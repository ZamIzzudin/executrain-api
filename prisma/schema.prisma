generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  username     String
  display_name String?
  password     String
  role         Role     @default(ADMIN)
  created_at   DateTime @default(now())

  @@index([username])
}

model SkillAccelerator {
  id          String                    @id @default(nanoid()) @db.VarChar(24)
  title       String
  banner      Json                      @default("{\"url\": \"\", \"public_id\": \"\"}")
  category    String
  description String
  student     Int                       @default(0)
  duration    Int                       @default(0)
  skill_level SkillAcceleratorLevel     @default(BEGINNER)
  language    SkillAcceleratorLanguage  @default(INDONESIA)
  feature     String[]
  updated_at  DateTime                  @default(now())
  created_at  DateTime                  @default(now())

  @@index([category])
  @@index([created_at])
}

model Course {
  id             String        @id @default(nanoid()) @db.VarChar(24)
  title          String
  banner         Json          @default("{\"url\": \"\", \"public_id\": \"\"}")
  category       String
  description    String
  student        Int           @default(0)
  duration       Int           @default(0)
  skill_level    CourseLevel   @default(BEGINNER)
  language       CourseLanguage @default(INDONESIA)
  framework_type String        @default("Training")
  feature        String[]
  updated_at     DateTime      @default(now())
  created_at     DateTime      @default(now())

  @@index([category])
  @@index([created_at])
}

model MasterData {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  type       String
  label      String
  value      String
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([type, value])
  @@index([type, sort_order])
}

model ITProduct {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  description String
  banner      Json     @default("{\"url\": \"\", \"public_id\": \"\"}")
  tech_stack  String[]
  link        String?
  problem     String?
  feature     String[]
  compliance  String?
  highlight   Json     @default("[]")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([created_at])
}

model AppDevelopment {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  tech_stack  String[]
  description String
  challenge   String?
  team_size   Json     @default("[]")
  timeline    Int      @default(0)
  methodology String?
  compliance  String?
  highlights  Json     @default("[]")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([created_at])
}

model CaseStudy {
  id              String   @id @default(nanoid()) @db.VarChar(24)
  title           String
  category        String?
  description     String
  industries      String[]
  solutions       String[]
  deployment_type String?
  timeline        Int      @default(0)
  compliance      String?
  methodology     String?
  team_size       Json     @default("[]")
  testimonial     Json     @default("{\"testimoni\": \"\", \"name\": \"\", \"company\": \"\"}")
  link            String?
  updated_at      DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([created_at])
}

model Article {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  title      String
  category   String[]
  content    String   @db.Text
  updated_at DateTime @default(now())
  created_at DateTime @default(now())

  @@index([created_at])
}

/// Content Management: Asset
model Asset {
  id                 String        @id @default(nanoid()) @db.VarChar(24)
  category           AssetCategory @unique
  name               String
  url                String
  public_id          String        @default("")
  fallback_url       String        @default("")
  fallback_public_id String        @default("")
  type               AssetType     @default(image)
  is_active          Boolean       @default(true)
  updated_at         DateTime      @default(now())
  created_at         DateTime      @default(now())
}

/// Content Management: Partner
model Partner {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  partner_name String?
  logo         Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at   DateTime @default(now())
  created_at   DateTime @default(now())
}

/// Content Management: Career
model Career {
  id                     String          @id @default(nanoid()) @db.VarChar(24)
  title                  String
  slug                   String          @unique
  description            String[]
  requirements           String[]
  experiance_requirement String[]
  applicant_question     String[]
  location               String
  department             String          @default("")
  job_type               JobType         @default(FULL_TIME)
  experience_level       ExperienceLevel @default(MID)
  vacancies              Int             @default(1)
  contact_email          String          @default("")
  deadline               DateTime?
  status                 JobStatus       @default(DRAFT)
  applicants_count       Int             @default(0)
  views                  Int             @default(0)
  updated_at             DateTime        @default(now())
  created_at             DateTime        @default(now())

  applicants CareerApplicant[]

  @@index([status])
  @@index([department])
  @@index([location])
}

/// Content Management: CareerApplicant
model CareerApplicant {
  id                String            @id @default(nanoid()) @db.VarChar(24)
  career_id         String            @db.VarChar(24)
  full_name         String
  email             String
  phone             String
  cover_letter      String?
  resume            Json              @default("{}")
  portfolio_url     String?
  linkedin_url      String?
  github_url        String?
  experience_years  Int               @default(0)
  current_position  String?
  current_company   String?
  availability_date DateTime?
  status            ApplicationStatus @default(PENDING)
  notes             String?
  applied_at        DateTime          @default(now())
  updated_at        DateTime          @default(now())

  career Career @relation(fields: [career_id], references: [id], onDelete: Cascade)

  @@index([career_id])
  @@index([email])
  @@index([status])
}

/// Content Management: CareerGallery
model CareerGallery {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  title       String
  description String   @default("")
  image       Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([order])
  @@index([is_active])
}

/// Content Management: Gallery
model Gallery {
  id         String   @id @default(nanoid()) @db.VarChar(24)
  title      String   @default("")
  image      Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  order      Int      @default(0)
  is_active  Boolean  @default(true)
  updated_at DateTime @default(now())
  created_at DateTime @default(now())

  @@index([order])
  @@index([is_active])
}

/// Content Management: Socmed
model Socmed {
  id          String   @id @default(nanoid()) @db.VarChar(24)
  socmed_name String?
  socmed_link String?
  logo        Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at  DateTime @default(now())
  created_at  DateTime @default(now())
}

/// Content Management: Statistic
model Statistic {
  id                       String   @id @default(nanoid()) @db.VarChar(24)
  year_experience          Int?
  total_participant        Int?
  total_topic_class        Int?
  total_training_completed Int?
  updated_at               DateTime @default(now())
  created_at               DateTime @default(now())
}

/// Content Management: Testimonial
model Testimonial {
  id           String   @id @default(nanoid()) @db.VarChar(24)
  person_name  String?
  person_title String?
  testimonial  String?
  photo        Json     @default("{\"public_id\":\"\",\"url\":\"\"}")
  updated_at   DateTime @default(now())
  created_at   DateTime @default(now())
}

enum AssetCategory {
  hero_background
  hero_video
  about_image
  statistic_background
  steps_background
  services_image
  cta_schedule_image
  contact_image
  framework_banner
  hero_blog
  hero_career
  hero_contact
  hero_free_trial
  hero_product
  hero_schedule
  hero_service
}

enum AssetType {
  image
  video
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum SkillAcceleratorLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillAcceleratorLanguage {
  INDONESIA
  ENGLISH
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseLanguage {
  INDONESIA
  ENGLISH
}