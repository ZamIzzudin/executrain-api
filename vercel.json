{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ["node_modules/.prisma/client/**", "node_modules/@prisma/client/**"]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
