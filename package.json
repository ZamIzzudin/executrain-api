{
  "name": "executrain-api",
  "version": "1.0.0",
  "description": "ExecuTrain API (Express + PostgreSQL/Prisma)",
  "license": "ISC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "node src/scripts/run-prisma-dev.js prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:sync-dev": "node src/scripts/create-dev-db.js",
    "db:studio:dev": "node src/scripts/run-prisma-dev.js prisma studio",
    "db:push:dev": "node src/scripts/run-prisma-dev.js prisma db push",
    "build": "node --check server.js && node --check src/config/prisma.js && prisma generate && echo \"API build OK (Express)\""
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "^3.0.1",
    "prisma": "^7.8.0"
  }
}
